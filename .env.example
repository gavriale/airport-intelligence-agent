ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=30

# Only for running outside docker compose:
# DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# POSTGRES_PORT=5433                      # host port of Postgres (default 5432); set it if 5432 is taken
# API_PORT=8001                           # host port of the API (default 8000)

# Development only: replay identical LLM calls from .llm_cache/ (never used by evals)
# LLM_CACHE=1

# Log format: json (default) or console (readable, for local debugging)
# LOG_FORMAT=console
